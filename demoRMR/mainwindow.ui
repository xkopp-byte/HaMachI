  <property name="styleSheet">
   <string notr="true">
QWidget { font-family: &quot;Segoe UI&quot;; font-size: 14px; color: #14243b; }
QWidget#centralWidget { background-color: #eef1f5; }
QLabel { background-color: transparent; }
QLabel#connectionStatusLabel { color: #596579; }
QLabel#connectionDotLabel { color: #7b8491; font-size: 23px; }
QGroupBox {
    background-color: #f8f9fb; border: 1px solid #c9d0da;
    border-radius: 3px; margin-top: 10px; padding: 4px; padding-top: 12px;
}
QGroupBox::title {
    subcontrol-origin: margin; subcontrol-position: top left;
    left: 10px; padding: 0px 4px; color: #152b4b;
}
QPushButton {
    background-color: #e6eaf0; border: 1px solid #aeb8c6;
    border-radius: 3px; padding: 8px 12px; min-height: 24px;
}
QPushButton:hover { background-color: #dceafa; border-color: #6c9aca; }
QPushButton:pressed, QPushButton:checked { background-color: #c5d9ef; border-color: #4b79a8; }
QPushButton:focus { border: 2px solid #2375bd; }
QPushButton:disabled { color: #87909c; background-color: #ebedf0; border-color: #ccd1d8; }
QPushButton#safetyStopButton {
    background-color: #dc2626; color: white; border: 1px solid #b91c1c;
    font-size: 16px; font-weight: bold; min-height: 28px;
}
QPushButton#safetyStopButton:hover { background-color: #c91e1e; }
QPushButton#safetyStopButton:pressed { background-color: #991b1b; }
QLineEdit, QComboBox {
    background-color: white; border: 1px solid #aeb8c6;
    border-radius: 3px; padding: 7px 8px; min-height: 24px;
}
QLineEdit:focus, QComboBox:focus { border-color: #2375bd; }
QLineEdit:read-only { background-color: #e9edf2; color: #647084; }
QComboBox { padding-right: 24px; }
QComboBox QAbstractItemView {
    background-color: white; color: #14243b;
    selection-background-color: #dceafa; selection-color: #14243b;
}
QCheckBox { spacing: 8px; padding: 5px 0px; }
QCheckBox::indicator { width: 20px; height: 20px; }
QFrame#warningFrame { background-color: #dc2626; border: 1px solid #b91c1c; border-radius: 3px; }
QLabel#warningIconLabel { background-color: white; color: #dc2626; border-radius: 16px; font-size: 24px; font-weight: bold; }
QLabel#warningTitleLabel { color: white; font-size: 16px; font-weight: bold; }
QLabel#warningMessageLabel { color: white; }
QWidget#widget { background-color: #242d38; border: 1px solid #647184; border-radius: 3px; }
QLabel#cameraPlaceholderLabel { color: #ccd5df; font-size: 16px; border: none; }
QFrame#lidarView { background-color: #0d2335; border: 1px solid #31495e; border-radius: 3px; }
QLabel#frontOrientationLabel, QLabel#rearOrientationLabel { color: #b4c9dc; font-size: 13px; }
QLabel#robotCenterLabel {
    color: #24c7e0; background-color: #253e52; border: 1px solid #becbd7;
    border-radius: 23px; font-size: 24px;
}
QLabel#lidarPlaceholderLabel { color: #b4c9dc; }

QPushButton#safetyStopButton { font-size: 23px; min-height: 42px; }
QFrame#warningFrame { background-color: rgba(87, 62, 5, 225); border: 1px solid #e3a81b; }
QLabel#warningIconLabel { color: #ffbd32; background: transparent; }
QLabel#warningTitleLabel, QLabel#warningMessageLabel { color: #ffcf55; }
QFrame#dangerFrame { background-color: rgba(157, 27, 30, 235); border: 2px solid #ff4545; border-radius: 4px; }
QLabel#dangerTitleLabel { color: white; font-size: 25px; font-weight: bold; }
QLabel#dangerMessageLabel { color: white; font-size: 16px; }
QGroupBox#parkingAssistantGroup { background-color: rgba(32, 40, 48, 230); border: 1px solid #8c959e; color: #e2e7ec; }
QGroupBox#parkingAssistantGroup::title { color: #e2e7ec; }
QFrame#lidarView { background-color: transparent; border: none; }
QLabel#fusionOverlayLabel, QLabel#motionOverlayLabel { background: transparent; border: none; }
</string>
  </property>
  <property name="darkStyleSheet" stdset="0"><string notr="true">
QWidget { color: #e5e7eb; }
QMainWindow, QWidget#centralWidget, QWidget#controlsPanel { background-color: #202630; }
QGroupBox { color: #e5e7eb; border-color: #536170; }
QPushButton { background-color: #354150; color: #f3f4f6; border-color: #617185; }
QPushButton:hover { background-color: #46566a; }
QPushButton:pressed, QPushButton:checked { background-color: #526781; }
QLineEdit, QComboBox { background-color: #293443; color: #f3f4f6; border-color: #617185; }
QComboBox QAbstractItemView { background-color: #293443; color: #f3f4f6; selection-background-color: #526781; }
QWidget:disabled { color: #8893a2; }
QPushButton#safetyStopButton { background-color: #dc2626; color: white; }
QPushButton#safetyStopButton:hover { background-color: #ef4444; }
